---
/**
 * Scaffold: testimonials section. Compose TestimonialList via default slot.
 */
import Section from "../components/layouts/Section.astro";
import Container from "../components/layouts/Container.astro";
import type { ContainerWidth } from "../types/content";

interface Props {
	id: string;
	width?: ContainerWidth;
	class?: string;
}

const { id, width = "default", class: className } = Astro.props;
---

<Section id={id} class:list={["testimonials-section", className]}>
	<Container width={width}>
		<slot />
	</Container>
</Section>
