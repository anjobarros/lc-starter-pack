---
interface Props {
	id: string;
	class?: string;
	[key: string]: unknown;
}

const { id, class: className, ...rest } = Astro.props;
---

<section
	id={id}
	class:list={["section", className]}
	{...rest}
>
	<slot />
</section>

<style>
	.section {
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		gap: var(--section-container-gap);
		width: 100%;
		padding-block: var(--space-section-y);
		padding-inline: var(--section-padding-inline);
	}
</style>
