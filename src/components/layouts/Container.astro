---
interface Props {
	width?: "default" | "full" | "narrow";
	class?: string;
	[key: string]: unknown;
}

const { width = "default", class: className, ...rest } = Astro.props;
---

<div
	class:list={["section__container", className]}
	data-width={width}
	{...rest}
>
	<slot />
</div>

<style>
	.section__container {
		box-sizing: border-box;
		width: 100%;
		margin-inline: auto;
		max-width: var(--container-max-width);
	}

	.section__container[data-width="full"] {
		max-width: 100%;
	}

	.section__container[data-width="narrow"] {
		max-width: var(--container-narrow-width);
	}
</style>
