---
interface Props {
	id: string;
	name: string;
	type?:
		| "text"
		| "email"
		| "password"
		| "search"
		| "tel"
		| "url"
		| "number"
		| "date"
		| "datetime-local"
		| "time"
		| "checkbox"
		| "radio"
		| "file"
		| "hidden";
	status?: "default" | "error" | "success";
	value?: string | number;
	placeholder?: string;
	required?: boolean;
	disabled?: boolean;
	readonly?: boolean;
	checked?: boolean;
	autocomplete?: string;
	min?: string | number;
	max?: string | number;
	step?: string | number;
	accept?: string;
	multiple?: boolean;
	ariaLabel?: string;
	ariaDescribedby?: string;
	ariaInvalid?: boolean | "true" | "false" | "grammar" | "spelling";
	class?: string;
}

const {
	id,
	name,
	type = "text",
	status = "default",
	value,
	placeholder,
	required = false,
	disabled = false,
	readonly = false,
	checked,
	autocomplete,
	min,
	max,
	step,
	accept,
	multiple = false,
	ariaLabel,
	ariaDescribedby,
	ariaInvalid,
	class: className,
} = Astro.props;

const isChoice = type === "checkbox" || type === "radio";
const isFile = type === "file";
const isHidden = type === "hidden";
const resolvedInvalid =
	ariaInvalid ?? (status === "error" ? true : undefined);
---

<input
	id={id}
	name={name}
	type={type}
	value={value}
	placeholder={placeholder}
	required={required}
	disabled={disabled}
	readonly={readonly}
	checked={checked}
	autocomplete={autocomplete}
	min={min}
	max={max}
	step={step}
	accept={accept}
	multiple={multiple || undefined}
	aria-label={ariaLabel}
	aria-describedby={ariaDescribedby}
	aria-invalid={resolvedInvalid}
	class:list={[
		"input",
		isChoice && "input--choice",
		isFile && "input--file",
		isHidden && "input--hidden",
		className,
	]}
	data-status={isChoice || isHidden ? undefined : status}
/>

<style>
	.input {
		box-sizing: border-box;
		width: 100%;
		max-width: 100%;
		min-height: 48px;
		margin: 0;
		padding-block: var(--space-1);
		padding-inline: var(--space-2);
		border-width: var(--border-width);
		border-style: var(--border-style);
		border-color: var(--color-border-strong);
		border-radius: var(--radius-md);
		background-color: var(--color-surface);
		font-family: var(--font-family-primary);
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-regular);
		line-height: var(--line-height-body);
		color: var(--color-text);
		transition: var(--transition-default);
	}

	.input::placeholder {
		color: var(--color-text-muted);
	}

	.input:hover:not(:disabled):not([readonly]) {
		border-color: var(--color-primary);
	}

	.input:focus,
	.input:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: 2px;
		border-color: var(--color-primary);
	}

	.input[data-status="error"],
	.input[aria-invalid="true"] {
		border-color: var(--color-danger);
	}

	.input[data-status="error"]:focus,
	.input[data-status="error"]:focus-visible,
	.input[aria-invalid="true"]:focus,
	.input[aria-invalid="true"]:focus-visible {
		outline-color: var(--color-danger);
		border-color: var(--color-danger);
	}

	.input[data-status="success"] {
		border-color: var(--color-success);
	}

	.input[data-status="success"]:focus,
	.input[data-status="success"]:focus-visible {
		outline-color: var(--color-success);
		border-color: var(--color-success);
	}

	.input:disabled {
		border-color: var(--color-border);
		background-color: var(--color-surface-elevated);
		color: var(--color-text-muted);
		cursor: not-allowed;
		opacity: 0.7;
	}

	.input[readonly] {
		border-color: var(--color-border);
		background-color: var(--color-surface-elevated);
		color: var(--color-text);
		cursor: default;
	}

	.input--choice {
		width: 1.25rem;
		height: 1.25rem;
		min-height: 0;
		padding: 0;
		border-color: var(--color-border-strong);
		background-color: var(--color-surface);
		accent-color: var(--color-primary);
		cursor: pointer;
	}

	.input--choice[type="checkbox"] {
		border-radius: var(--radius-sm);
	}

	.input--choice[type="radio"] {
		border-radius: var(--radius-full);
	}

	.input--choice:disabled {
		cursor: not-allowed;
	}

	.input--file {
		padding-block: var(--space-1);
		cursor: pointer;
	}

	.input--file::file-selector-button {
		margin-inline-end: var(--space-2);
		padding-block: var(--space-1);
		padding-inline: var(--space-2);
		border: var(--border-default);
		border-radius: var(--radius-sm);
		background-color: var(--color-surface-elevated);
		font: inherit;
		font-weight: var(--font-weight-semibold);
		color: var(--color-text);
		cursor: pointer;
		transition: var(--transition-default);
	}

	.input--file:hover:not(:disabled)::file-selector-button {
		border-color: var(--color-primary);
		background-color: var(--color-primary-soft);
		color: var(--color-accent);
	}

	.input--hidden {
		display: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.input,
		.input--file::file-selector-button {
			transition: none;
		}
	}
</style>
