---
/**
 * Vertical content stack. Parent owns spacing via gap (no child margins).
 */
interface Props {
	gap?: "tight" | "stack" | "loose";
	as?: "div" | "ul" | "ol" | "section";
	class?: string;
}

const { gap = "stack", as: Tag = "div", class: className } = Astro.props;
---

<Tag class:list={["stack", className]} data-gap={gap}>
	<slot />
</Tag>

<style>
	.stack {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		width: 100%;
	}

	.stack[data-gap="tight"] {
		gap: var(--space-stack-tight);
	}

	.stack[data-gap="stack"] {
		gap: var(--space-stack);
	}

	.stack[data-gap="loose"] {
		gap: var(--space-stack-loose);
	}
</style>
