---
/**
 * Aspect-ratio media frame. Default slot should be Image / media.
 */
interface Props {
	ratio?: string;
	as?: "div" | "figure";
	class?: string;
}

const { ratio = "16 / 9", as: Tag = "div", class: className } = Astro.props;
---

<Tag
	class:list={["frame", className]}
	style={{ "--frame-ratio": ratio }}
>
	<slot />
</Tag>

<style>
	.frame {
		display: block;
		overflow: hidden;
		width: 100%;
		aspect-ratio: var(--frame-ratio);
	}

	.frame > :global(img),
	.frame > :global(video),
	.frame > :global(iframe),
	.frame > :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
</style>
