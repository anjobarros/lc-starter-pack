---
/**
 * Centered measure: max-width content column inside a parent.
 */
interface Props {
	max?: "narrow" | "default" | "prose";
	as?: "div" | "section" | "article";
	class?: string;
}

const { max = "narrow", as: Tag = "div", class: className } = Astro.props;
---

<Tag class:list={["center", className]} data-max={max}>
	<slot />
</Tag>

<style>
	.center {
		box-sizing: border-box;
		width: 100%;
		margin-inline: auto;
	}

	.center[data-max="narrow"] {
		max-width: var(--container-narrow-width);
	}

	.center[data-max="default"] {
		max-width: var(--container-max-width);
	}

	.center[data-max="prose"] {
		max-width: 65ch;
	}
</style>
