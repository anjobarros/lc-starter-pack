---
/**
 * Responsive multi-column content grid. No Column primitive required.
 */
interface Props {
	gap?: "tight" | "stack" | "loose";
	as?: "div" | "ul" | "ol" | "section";
	min?: string;
	columns?: number;
	class?: string;
}

const {
	gap = "loose",
	as: Tag = "div",
	min = "16rem",
	columns,
	class: className,
} = Astro.props;

const templateColumns =
	typeof columns === "number" && columns > 0
		? `repeat(${columns}, minmax(0, 1fr))`
		: `repeat(auto-fit, minmax(min(100%, ${min}), 1fr))`;
---

<Tag
	class:list={["grid", className]}
	data-gap={gap}
	style={{ "--grid-template-columns": templateColumns }}
>
	<slot />
</Tag>

<style>
	.grid {
		display: grid;
		width: 100%;
		grid-template-columns: var(--grid-template-columns);
	}

	.grid[data-gap="tight"] {
		gap: var(--space-stack-tight);
	}

	.grid[data-gap="stack"] {
		gap: var(--space-stack);
	}

	.grid[data-gap="loose"] {
		gap: var(--space-stack-loose);
	}
</style>
