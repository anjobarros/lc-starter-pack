---
/**
 * Team member: media → body (ContentBlock) → footer (socials / ButtonGroup).
 */
interface Props {
	id?: string;
	class?: string;
}

const { id, class: className } = Astro.props;
---

<article id={id} class:list={["team-card", className]}>
	<div class="team-card__media">
		<slot name="media" />
	</div>
	<div class="team-card__body">
		<slot name="body" />
	</div>
	<div class="team-card__footer">
		<slot name="footer" />
	</div>
</article>

<style>
	.team-card {
		display: flex;
		flex-direction: column;
		gap: var(--space-stack);
		min-width: 0;
	}

	.team-card__media:empty,
	.team-card__footer:empty {
		display: none;
	}

	.team-card__body {
		display: flex;
		flex-direction: column;
		gap: var(--space-stack);
		min-width: 0;
	}

	.team-card__footer {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-stack-tight);
	}
</style>
