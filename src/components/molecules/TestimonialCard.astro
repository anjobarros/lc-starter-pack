---
/**
 * Testimonial: body (quote / ContentBlock) → footer (avatar + attribution).
 */
interface Props {
	id?: string;
	class?: string;
}

const { id, class: className } = Astro.props;
---

<blockquote id={id} class:list={["testimonial-card", className]}>
	<div class="testimonial-card__body">
		<slot name="body" />
	</div>
	<footer class="testimonial-card__footer">
		<div class="testimonial-card__avatar">
			<slot name="avatar" />
		</div>
		<div class="testimonial-card__meta">
			<slot name="name" />
			<slot name="role" />
		</div>
	</footer>
</blockquote>

<style>
	.testimonial-card {
		display: flex;
		flex-direction: column;
		gap: var(--space-stack-loose);
		margin: 0;
		min-width: 0;
	}

	.testimonial-card__body {
		display: flex;
		flex-direction: column;
		gap: var(--space-stack);
		min-width: 0;
	}

	.testimonial-card__footer {
		display: flex;
		align-items: center;
		gap: var(--space-stack-tight);
	}

	.testimonial-card__avatar {
		flex-shrink: 0;
		line-height: 0;
	}

	.testimonial-card__avatar:empty {
		display: none;
	}

	.testimonial-card__meta {
		display: flex;
		flex-direction: column;
		gap: var(--space-stack-tight);
		min-width: 0;
	}
</style>
