---
/**
 * Scaffold: split media + content (not a Section). Compose ContentBlock + Image/MediaBlock.
 */
interface Props {
	reverse?: boolean;
	id?: string;
	class?: string;
}

const { reverse = false, id, class: className } = Astro.props;
---

<div
	id={id}
	class:list={["media-split", className]}
	data-reverse={reverse ? "true" : undefined}
>
	<div class="media-split__media">
		<slot name="media" />
	</div>
	<div class="media-split__content">
		<slot name="content" />
		<div class="media-split__actions">
			<slot name="actions" />
		</div>
	</div>
	<slot />
</div>

<style>
	.media-split {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-stack-loose);
		align-items: center;
		width: 100%;
	}

	.media-split__media {
		min-width: 0;
	}

	.media-split__content {
		display: flex;
		flex-direction: column;
		gap: var(--space-stack-loose);
		min-width: 0;
	}

	.media-split__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-stack-tight);
	}

	.media-split[data-reverse="true"] .media-split__media {
		order: 2;
	}

	.media-split[data-reverse="true"] .media-split__content {
		order: 1;
	}

	.media-split__media:empty,
	.media-split__actions:empty {
		display: none;
	}

	@media screen and (max-width: 1024px) {
		.media-split {
			grid-template-columns: 1fr;
		}

		.media-split[data-reverse="true"] .media-split__media,
		.media-split[data-reverse="true"] .media-split__content {
			order: unset;
		}
	}
</style>
