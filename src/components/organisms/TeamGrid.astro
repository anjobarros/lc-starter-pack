---
/**
 * Scaffold: team cards collection. Compose TeamCard children via default slot.
 */
interface Props {
	id?: string;
	class?: string;
}

const { id, class: className } = Astro.props;
---

<div id={id} class:list={["team-grid", className]}>
	<div class="team-grid__header">
		<slot name="header" />
	</div>
	<div class="team-grid__items">
		<slot />
	</div>
</div>

<style>
	.team-grid {
		display: flex;
		flex-direction: column;
		gap: var(--space-stack-loose);
		width: 100%;
	}

	.team-grid__header:empty {
		display: none;
	}

	.team-grid__items {
		display: flex;
		flex-direction: column;
		gap: var(--space-stack-loose);
	}
</style>
