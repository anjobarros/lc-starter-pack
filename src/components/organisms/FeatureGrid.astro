---
/**
 * Scaffold: feature cards collection. Compose FeatureCard children via default slot.
 */
interface Props {
	columns?: 2 | 3 | 4;
	id?: string;
	class?: string;
}

const { columns = 3, id, class: className } = Astro.props;
---

<div
	id={id}
	class:list={["feature-grid", className]}
	style={{ "--feature-grid-columns": String(columns) }}
>
	<div class="feature-grid__header">
		<slot name="header" />
	</div>
	<div class="feature-grid__items">
		<slot />
	</div>
</div>

<style>
	.feature-grid {
		display: flex;
		flex-direction: column;
		gap: var(--space-stack-loose);
		width: 100%;
	}

	.feature-grid__header:empty {
		display: none;
	}

	.feature-grid__items {
		display: grid;
		grid-template-columns: repeat(var(--feature-grid-columns, 3), minmax(0, 1fr));
		gap: var(--space-stack-loose);
		width: 100%;
	}

	@media screen and (max-width: 1024px) {
		.feature-grid__items {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media screen and (max-width: 768px) {
		.feature-grid__items {
			grid-template-columns: 1fr;
		}
	}
</style>
