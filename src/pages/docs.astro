</BaseLayout>


<script>
	const tocLinks = Array.from(
		document.querySelectorAll<HTMLAnchorElement>(".docs__toc-link[href^='#']"),
	);

	document.querySelectorAll(".docs__toc-summary a").forEach((link) => {
		link.addEventListener("click", (event) => {
			event.stopPropagation();
		});
	});

	const setActiveLink = (id: string) => {
		tocLinks.forEach((link) => {
			const isActive = link.getAttribute("href") === `#${id}`;
			link.classList.toggle("is-active", isActive);

			if (isActive) {
				link.setAttribute("aria-current", "location");
				const group = link.closest("details.docs__toc-group");
				if (group instanceof HTMLDetailsElement) group.open = true;
			} else {
				link.removeAttribute("aria-current");
			}
		});
	};

	const targets = tocLinks
		.map((link) => {
			const id = link.getAttribute("href")?.slice(1);
			return id ? document.getElementById(id) : null;
		})
		.filter((el): el is HTMLElement => Boolean(el));

	if (targets.length > 0) {
		const visible = new Map<string, number>();

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					const id = entry.target.id;
					if (entry.isIntersecting) {
						visible.set(id, entry.intersectionRatio);
					} else {
						visible.delete(id);
					}
				}

				const activeId = [...visible.entries()].sort((a, b) => b[1] - a[1])[0]?.[0];
				if (activeId) setActiveLink(activeId);
			},
			{
				rootMargin: "-20% 0px -60% 0px",
				threshold: [0, 0.25, 0.5, 1],
			},
		);

		targets.forEach((target) => observer.observe(target));

		const hashId = window.location.hash.slice(1);
		if (hashId && document.getElementById(hashId)) {
			setActiveLink(hashId);
		} else if (targets[0]) {
			setActiveLink(targets[0].id);
		}
	}
</script>

