---
import Badge from "../components/atoms/Badge.astro";
import Button from "../components/atoms/Button.astro";
import Heading from "../components/atoms/Heading.astro";
import Icon from "../components/atoms/Icon.astro";
import Image from "../components/atoms/Image.astro";
import Input from "../components/atoms/Input.astro";
import Text from "../components/atoms/Text.astro";
import Cluster from "../components/content/Cluster.astro";
import Grid from "../components/content/Grid.astro";
import Stack from "../components/content/Stack.astro";
import Container from "../components/layouts/Container.astro";
import Section from "../components/layouts/Section.astro";
import AccordionItem from "../components/molecules/AccordionItem.astro";
import BaseCard from "../components/molecules/BaseCard.astro";
import Breadcrumbs from "../components/molecules/Breadcrumbs.astro";
import ButtonGroup from "../components/molecules/ButtonGroup.astro";
import ContactDetails from "../components/molecules/ContactDetails.astro";
import ContentBlock from "../components/molecules/ContentBlock.astro";
import FeatureCard from "../components/molecules/FeatureCard.astro";
import FormField from "../components/molecules/FormField.astro";
import IconListItem from "../components/molecules/IconListItem.astro";
import IconText from "../components/molecules/IconText.astro";
import LogoGroup from "../components/molecules/LogoGroup.astro";
import MediaBlock from "../components/molecules/MediaBlock.astro";
import PostCard from "../components/molecules/PostCard.astro";
import SectionHeading from "../components/molecules/SectionHeading.astro";
import ServiceCard from "../components/molecules/ServiceCard.astro";
import TeamCard from "../components/molecules/TeamCard.astro";
import TestimonialCard from "../components/molecules/TestimonialCard.astro";
import CtaBanner from "../components/organisms/CtaBanner.astro";
import FaqAccordion from "../components/organisms/FaqAccordion.astro";
import FeatureGrid from "../components/organisms/FeatureGrid.astro";
import Hero from "../components/organisms/Hero.astro";
import MediaSplit from "../components/organisms/MediaSplit.astro";
import { brandkitToc } from "../data/brandkitToc";
import "../styles/global.css";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Brandkit</title>
	</head>
	<body>
		<div class="brandkit">
			<aside class="brandkit__aside" aria-labelledby="heading-toc">
				<nav class="brandkit__toc" aria-labelledby="heading-toc">
					<Heading level={2} id="heading-toc">Contents</Heading>
					<ul class="brandkit__toc-list">
						{
							brandkitToc.map((item) =>
								item.children?.length ? (
									<li>
										<details class="brandkit__toc-group" open>
											<summary class="brandkit__toc-summary">
												<a
													class="brandkit__toc-link brandkit__toc-link--parent"
													href={item.href}
												>
													{item.label}
												</a>
											</summary>
											<ul class="brandkit__toc-list brandkit__toc-list--nested">
												{item.children.map((child) => (
													<li>
														<a class="brandkit__toc-link" href={child.href}>
															{child.label}
														</a>
													</li>
												))}
											</ul>
										</details>
									</li>
								) : (
									<li>
										<a class="brandkit__toc-link" href={item.href}>
											{item.label}
										</a>
									</li>
								),
							)
						}
					</ul>
				</nav>
			</aside>

			<main class="brandkit__main">
				<Section id="intro" aria-labelledby="heading-brandkit">
					<Container>
						<Heading level={1} id="heading-brandkit">Brandkit</Heading>
						<Text>
							Atomic Design reference: atoms, molecules, organisms (Hero, CTA, Features,
							Split), and content layout helpers — not page-only section wiring.
						</Text>
					</Container>
				</Section>

				<Section id="atoms" aria-labelledby="heading-atoms">
					<Container>
						<ContentBlock>
							<Heading slot="title" level={2} id="heading-atoms">Atoms</Heading>
							<Text slot="body">
								Single-purpose UI primitives. Each atom has one job, exposes typed props,
								and is composed into molecules — never rebuilt inside page markup.
							</Text>
						</ContentBlock>
					</Container>

					<Container class="atom-container" id="atom-heading" aria-labelledby="heading-heading">
						<ContentBlock>
							<Heading slot="title" level={3} id="heading-heading">Heading</Heading>
							<Text slot="body">
								Use for page and section titles. Structure: a semantic <code>h1</code>–<code>h6</code>
								via the <code>level</code> prop, with label text in the default slot. Keep one
								<code>h1</code> per page; section titles usually start at <code>h2</code>.
							</Text>
						</ContentBlock>
						<div class="atom-demo">
							<Heading level={1}>Heading level 1</Heading>
							<Heading level={2}>Heading level 2</Heading>
							<Heading level={3}>Heading level 3</Heading>
							<Heading level={4}>Heading level 4</Heading>
							<Heading level={5}>Heading level 5</Heading>
							<Heading level={6}>Heading level 6</Heading>
						</div>
					</Container>

					<Container class="atom-container" id="atom-text" aria-labelledby="heading-text">
						<ContentBlock>
							<Heading slot="title" level={3} id="heading-text">Text</Heading>
							<Text slot="body">
								Use for body and inline copy. Structure: a single text node rendered as
								<code>p</code>, <code>span</code>, <code>strong</code>, <code>em</code>, or
								<code>small</code> through the <code>as</code> prop. Prefer this atom over raw
								paragraphs so typography stays token-driven.
							</Text>
						</ContentBlock>
						<div class="atom-demo">
							<Text>Paragraph text</Text>
							<Text as="span">Inline span text</Text>
							<Text as="strong">Strong text</Text>
							<Text as="em">Emphasized text</Text>
							<Text as="small">Small text</Text>
						</div>
					</Container>

					<Container class="atom-container" id="atom-button" aria-labelledby="heading-button">
						<ContentBlock>
							<Heading slot="title" level={3} id="heading-button">Button</Heading>
							<Text slot="body">
								Use for actions and CTA links. Structure: renders a <code>button</code> or an
								<code>a</code> when <code>href</code> is set; shared <code>variant</code>
								(<code>primary</code> / <code>outline</code>), optional leading/trailing
								<code>Icon</code> children, and disabled/hover states on the same styles.
							</Text>
						</ContentBlock>
						<div class="atom-demo atom-demo--row">
							<Button type="button">Primary</Button>
							<Button type="button" variant="outline">Outline</Button>
							<Button type="button">
								<Icon name="add-outline" label="Add" size={20} />
								Icon left
							</Button>
							<Button type="button" variant="outline">
								Icon right
								<Icon name="arrow-forward-outline" label="Arrow" size={20} />
							</Button>
							<Button href="/">Link button</Button>
							<Button href="/" variant="outline">Outline link</Button>
							<Button disabled>Disabled</Button>
						</div>
					</Container>

					<Container class="atom-container" id="atom-badge" aria-labelledby="heading-badge">
						<ContentBlock>
							<Heading slot="title" level={3} id="heading-badge">Badge</Heading>
							<Text slot="body">
								Use for status, counts, and short labels — not for actions. Structure: appearance
								via <code>variant</code> (<code>soft</code> / <code>solid</code> / <code>outline</code>)
								and meaning via <code>tone</code>; optional <code>size</code>, status <code>dot</code>,
								and icon/text in the default slot.
							</Text>
						</ContentBlock>

						<div class="atom-demo">
							<Text as="strong">Soft</Text>
							<div class="atom-demo atom-demo--row">
								<Badge>Neutral</Badge>
								<Badge tone="primary">Primary</Badge>
								<Badge tone="success">Success</Badge>
								<Badge tone="warning">Warning</Badge>
								<Badge tone="danger">Danger</Badge>
								<Badge tone="info">Info</Badge>
							</div>
						</div>

						<div class="atom-demo">
							<Text as="strong">Solid</Text>
							<div class="atom-demo atom-demo--row">
								<Badge variant="solid">Neutral</Badge>
								<Badge variant="solid" tone="primary">Primary</Badge>
								<Badge variant="solid" tone="success">Success</Badge>
								<Badge variant="solid" tone="warning">Warning</Badge>
								<Badge variant="solid" tone="danger">Danger</Badge>
								<Badge variant="solid" tone="info">Info</Badge>
							</div>
						</div>

						<div class="atom-demo">
							<Text as="strong">Outline</Text>
							<div class="atom-demo atom-demo--row">
								<Badge variant="outline">Neutral</Badge>
								<Badge variant="outline" tone="primary">Primary</Badge>
								<Badge variant="outline" tone="success">Success</Badge>
								<Badge variant="outline" tone="warning">Warning</Badge>
								<Badge variant="outline" tone="danger">Danger</Badge>
								<Badge variant="outline" tone="info">Info</Badge>
							</div>
						</div>

						<div class="atom-demo">
							<Text as="strong">Size, dot, icon</Text>
							<div class="atom-demo atom-demo--row">
								<Badge size="sm" tone="primary">Small</Badge>
								<Badge size="md" tone="primary">Medium</Badge>
								<Badge tone="success" dot>Online</Badge>
								<Badge tone="warning" dot>Away</Badge>
								<Badge tone="danger" dot>Offline</Badge>
								<Badge tone="info">
									<Icon name="add-outline" label="New" size={12} />
									New
								</Badge>
								<Badge variant="outline" tone="primary">3</Badge>
							</div>
						</div>
					</Container>

					<Container class="atom-container" id="atom-input" aria-labelledby="heading-input">
						<ContentBlock>
							<Heading slot="title" level={3} id="heading-input">Input</Heading>
							<Text slot="body">
								Use as the raw form control atom. Structure: a native <code>input</code> with a
								single outline medium style, <code>type</code>, and <code>status</code>
								(<code>default</code> / <code>error</code> / <code>success</code>). Labels, hints,
								and errors belong in the <code>FormField</code> molecule around this atom.
							</Text>
						</ContentBlock>

						<div class="atom-demo">
							<Text as="strong">Types</Text>
							<Grid class="atom-demo__grid" columns={3} gap="stack">
								<div class="field">
									<label class="field__label" for="brandkit-text">Text</label>
									<Input id="brandkit-text" name="text" type="text" placeholder="Enter text" />
								</div>
								<div class="field">
									<label class="field__label" for="brandkit-email">Email</label>
									<Input id="brandkit-email" name="email" type="email" placeholder="you@example.com" autocomplete="email" />
								</div>
								<div class="field">
									<label class="field__label" for="brandkit-password">Password</label>
									<Input id="brandkit-password" name="password" type="password" placeholder="••••••••" autocomplete="current-password" />
								</div>
								<div class="field">
									<label class="field__label" for="brandkit-search">Search</label>
									<Input id="brandkit-search" name="search" type="search" placeholder="Search…" />
								</div>
								<div class="field">
									<label class="field__label" for="brandkit-tel">Telephone</label>
									<Input id="brandkit-tel" name="tel" type="tel" placeholder="+1 555 000 0000" />
								</div>
								<div class="field">
									<label class="field__label" for="brandkit-url">URL</label>
									<Input id="brandkit-url" name="url" type="url" placeholder="https://example.com" />
								</div>
								<div class="field">
									<label class="field__label" for="brandkit-number">Number</label>
									<Input id="brandkit-number" name="number" type="number" min={0} max={100} step={1} placeholder="0" />
								</div>
								<div class="field">
									<label class="field__label" for="brandkit-date">Date</label>
									<Input id="brandkit-date" name="date" type="date" />
								</div>
								<div class="field">
									<label class="field__label" for="brandkit-time">Time</label>
									<Input id="brandkit-time" name="time" type="time" />
								</div>
								<div class="field">
									<label class="field__label" for="brandkit-file">File</label>
									<Input id="brandkit-file" name="file" type="file" accept="image/*,.pdf" />
								</div>
							</Grid>
						</div>

						<div class="atom-demo">
							<Text as="strong">States</Text>
							<Grid class="atom-demo__grid" columns={3} gap="stack">
								<div class="field">
									<label class="field__label" for="brandkit-default">Default</label>
									<Input id="brandkit-default" name="default" placeholder="Default input" />
									<p class="field__hint" id="brandkit-default-hint">Helper text for additional context.</p>
								</div>
								<div class="field">
									<label class="field__label" for="brandkit-required">Required</label>
									<Input id="brandkit-required" name="required" required placeholder="Required input" />
								</div>
								<div class="field">
									<label class="field__label" for="brandkit-readonly">Readonly</label>
									<Input id="brandkit-readonly" name="readonly" readonly value="Readonly value" />
								</div>
								<div class="field">
									<label class="field__label" for="brandkit-disabled">Disabled</label>
									<Input id="brandkit-disabled" name="disabled" disabled value="Disabled value" />
								</div>
								<div class="field">
									<label class="field__label" for="brandkit-error">Error</label>
									<Input
										id="brandkit-error"
										name="error"
										status="error"
										value="Invalid value"
										ariaDescribedby="brandkit-error-hint"
									/>
									<p class="field__hint field__hint--error" id="brandkit-error-hint">Please enter a valid value.</p>
								</div>
								<div class="field">
									<label class="field__label" for="brandkit-success">Success</label>
									<Input
										id="brandkit-success"
										name="success"
										status="success"
										value="Looks good"
										ariaDescribedby="brandkit-success-hint"
									/>
									<p class="field__hint field__hint--success" id="brandkit-success-hint">Input looks valid.</p>
								</div>
							</Grid>
						</div>

						<div class="atom-demo">
							<Text as="strong">Choice controls</Text>
							<div class="atom-demo atom-demo--row">
								<label class="choice">
									<Input id="brandkit-checkbox" name="checkbox" type="checkbox" />
									Checkbox
								</label>
								<label class="choice">
									<Input id="brandkit-checkbox-checked" name="checkbox-checked" type="checkbox" checked />
									Checked
								</label>
								<label class="choice">
									<Input id="brandkit-checkbox-disabled" name="checkbox-disabled" type="checkbox" disabled />
									Disabled
								</label>
								<label class="choice">
									<Input id="brandkit-radio-a" name="radio-demo" type="radio" value="a" checked />
									Radio A
								</label>
								<label class="choice">
									<Input id="brandkit-radio-b" name="radio-demo" type="radio" value="b" />
									Radio B
								</label>
							</div>
						</div>
					</Container>

					<Container class="atom-container" id="atom-image" aria-labelledby="heading-image">
						<ContentBlock>
							<Heading slot="title" level={3} id="heading-image">Image</Heading>
							<Text slot="body">
								Use for responsive media with reserved space. Structure: a frame that holds an
								optional <code>img</code>, with <code>width</code>/<code>height</code> or
								<code>ratio</code>, <code>fit</code> (<code>cover</code> / <code>contain</code>),
								and a skeleton state when <code>src</code> is missing, loading, or broken.
							</Text>
						</ContentBlock>

						<div class="atom-demo">
							<Text as="strong">Loaded</Text>
							<div class="atom-demo atom-demo--row">
								<Image src="/favicon.svg" alt="Project favicon" width={96} height={96} fit="contain" />
								<Image
									src="/favicon.svg"
									alt="Wide favicon crop"
									width={240}
									height={135}
									fit="cover"
								/>
							</div>
						</div>

						<div class="atom-demo">
							<Text as="strong">Unavailable (skeleton)</Text>
							<div class="atom-demo atom-demo--row">
								<Image alt="Missing image placeholder" width={96} height={96} />
								<Image alt="Broken image placeholder" src="/does-not-exist.png" width={240} height={135} />
								<Image alt="Default ratio skeleton" ratio="16 / 9" class="image-demo-wide" />
							</div>
						</div>
					</Container>

					<Container class="atom-container" id="atom-icon" aria-labelledby="heading-icon">
						<ContentBlock>
							<Heading slot="title" level={3} id="heading-icon">Icon</Heading>
							<Text slot="body">
								Use for decorative or labeled glyphs next to actions and copy. Structure: pass
								<code>name</code> to inline an SVG from <code>src/icons/</code> (Ionicons outline
								demo set), or provide custom SVG via the default slot. Set <code>size</code> and
								optional <code>label</code> for accessibility; omit <code>label</code> when decorative.
							</Text>
						</ContentBlock>
						<div class="atom-demo atom-demo--row icon-demo">
							<Icon name="add-outline" label="Add" />
							<Icon name="arrow-forward-outline" label="Arrow forward" />
							<Icon name="search-outline" label="Search" />
							<Icon name="checkmark-outline" label="Checkmark" />
							<Icon name="close-outline" label="Close" />
							<Icon name="heart-outline" label="Heart" />
							<Icon name="home-outline" label="Home" />
							<Icon name="mail-outline" label="Mail" />
							<Icon name="person-outline" label="Person" />
							<Icon name="settings-outline" label="Settings" />
							<Icon name="warning-outline" label="Warning" />
							<Icon name="image-outline" label="Image" />
							<Icon name="star-outline" label="Star" />
							<Icon name="trash-outline" label="Trash" />
							<Icon name="menu-outline" label="Menu" />
							<Icon name="information-circle-outline" label="Information" />
						</div>
						<div class="atom-demo atom-demo--row icon-demo">
							<Icon name="home-outline" label="Home small" size={16} />
							<Icon name="home-outline" label="Home medium" size={24} />
							<Icon name="home-outline" label="Home large" size={32} />
						</div>
					</Container>
				</Section>

				<Section id="molecules" aria-labelledby="heading-molecules">
					<Container>
						<ContentBlock>
							<Heading slot="title" level={2} id="heading-molecules">Molecules</Heading>
							<Text slot="body">
								Focused atom combinations with one responsibility (cards, content stacks,
								button groups). Not full page compositions — Hero, CTA, Feature grids, and
								Split content live under Organisms.
							</Text>
						</ContentBlock>
					</Container>

					<Container class="atom-container" id="molecule-content-block" aria-labelledby="heading-content-block">
						<Heading level={3} id="heading-content-block">ContentBlock</Heading>
						<ContentBlock>
							<Badge slot="eyebrow" tone="primary">Eyebrow</Badge>
							<Heading slot="title" level={3}>Content block title</Heading>
							<Text slot="body">Short supporting copy for a flexible content stack.</Text>
						</ContentBlock>
					</Container>

					<Container class="atom-container" id="molecule-section-heading" aria-labelledby="heading-section-heading">
						<Heading level={3} id="heading-section-heading">SectionHeading</Heading>
						<SectionHeading>
							<Badge slot="eyebrow" tone="info">Section</Badge>
							<Heading slot="title" level={3}>Section heading</Heading>
							<Text slot="description">Intro copy used above a section’s content.</Text>
						</SectionHeading>
					</Container>

					<Container class="atom-container" id="molecule-button-group" aria-labelledby="heading-button-group">
						<Heading level={3} id="heading-button-group">ButtonGroup</Heading>
						<div class="atom-demo">
							<ButtonGroup>
								<Button>Primary</Button>
								<Button variant="outline">Secondary</Button>
							</ButtonGroup>
							<ButtonGroup orientation="vertical">
								<Button>Stacked primary</Button>
								<Button variant="outline">Stacked secondary</Button>
							</ButtonGroup>
						</div>
					</Container>

					<Container class="atom-container" id="molecule-icon-text" aria-labelledby="heading-icon-text">
						<Heading level={3} id="heading-icon-text">IconText</Heading>
						<IconText>
							<Icon slot="icon" name="checkmark-outline" label="Included" />
							<Heading slot="title" level={4}>Icon with text</Heading>
							<Text slot="body">Useful for feature rows and benefit lists.</Text>
						</IconText>
					</Container>

					<Container class="atom-container" id="molecule-media-block" aria-labelledby="heading-media-block">
						<Heading level={3} id="heading-media-block">MediaBlock</Heading>
						<MediaBlock>
							<Image slot="media" src="/favicon.svg" alt="Sample media" width={160} height={160} fit="contain" />
							<Text slot="caption">Optional caption under media.</Text>
						</MediaBlock>
					</Container>

					<Container class="atom-container" id="molecule-base-card" aria-labelledby="heading-base-card">
						<Heading level={3} id="heading-base-card">BaseCard</Heading>
						<BaseCard href="/brandkit">
							<Image slot="media" src="/favicon.svg" alt="" width={120} height={80} fit="contain" />
							<ContentBlock slot="body">
								<Heading slot="title" level={4}>Base card</Heading>
								<Text slot="body">Generic card shell for other card molecules.</Text>
							</ContentBlock>
							<Text slot="footer" as="small">Optional footer</Text>
						</BaseCard>
					</Container>

					<Container class="atom-container" id="molecule-feature-card" aria-labelledby="heading-feature-card">
						<Heading level={3} id="heading-feature-card">FeatureCard</Heading>
						<FeatureCard>
							<Icon slot="media" name="star-outline" label="Feature" size={28} />
							<ContentBlock slot="body">
								<Heading slot="title" level={4}>Feature title</Heading>
								<Text slot="body">Highlight a product capability or benefit.</Text>
							</ContentBlock>
							<Button slot="footer" variant="outline" href="/brandkit">Learn more</Button>
						</FeatureCard>
					</Container>

					<Container class="atom-container" id="molecule-icon-list-item" aria-labelledby="heading-icon-list-item">
						<Heading level={3} id="heading-icon-list-item">IconListItem</Heading>
						<ul class="molecule-list">
							<IconListItem>
								<Icon slot="media" name="checkmark-outline" label="Done" />
								<ContentBlock slot="body">
									<Text slot="title" as="strong">List item title</Text>
									<Text slot="body">Supporting detail for the list row.</Text>
								</ContentBlock>
							</IconListItem>
							<IconListItem>
								<Icon slot="media" name="arrow-forward-outline" label="Next" />
								<ContentBlock slot="body">
									<Text slot="title" as="strong">Another item</Text>
								</ContentBlock>
							</IconListItem>
						</ul>
					</Container>

					<Container class="atom-container" id="molecule-form-field" aria-labelledby="heading-form-field">
						<Heading level={3} id="heading-form-field">FormField</Heading>
						<Stack gap="loose">
							<FormField for="brandkit-field-default">
								<span slot="label">Full name</span>
